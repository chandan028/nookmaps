# Primary places provider (PRD §11). When unset, NookMaps falls back to OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Force a provider: "google" | "osm" | "demo". Leave empty for automatic (google → osm).
NOOKMAPS_PROVIDER=

# Optional ranking weight overrides as JSON (PRD §13), e.g. {"distance":0.35,"rating":0.2}
NOOKMAPS_RANKING_WEIGHTS=

# Optional: custom Overpass / Nominatim endpoints and a contact for the OSM User-Agent.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_CONTACT=

# GA4 measurement id (PRD §23). Analytics are disabled when empty.
NEXT_PUBLIC_GA_ID=
